{
  "mcpServers": {
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "disabled": false,
      "description": "Sequential thinking for better problem analysis and multiple solution proposals"
    },
    "context7": {
      "command": "npx",
      "args": [
        "@upstash/context7-mcp",
        "--transport",
        "stdio"
      ],
      "disabled": true,
      "description": "Context management and documentation server (needs CONTEXT7_API_KEY)"
    },
    "notion": {
      "command": "npx",
      "args": [
        "@notionhq/notion-mcp-server",
        "--transport",
        "stdio"
      ],
      "disabled": false,
      "description": "Notion API integration (already working)",
      "env": {
        "NOTION_TOKEN": ""
      }
    },
    "inspector": {
      "command": "npx",
      "args": [
        "@modelcontextprotocol/inspector"
      ],
      "disabled": true,
      "description": "Web interface for managing MCP servers"
    }
  },
  "mcpSettings": {
    "defaultTimeout": 30000,
    "maxRetries": 3,
    "autoRestart": true
  }
}