{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://foresight.design/survey-theme.schema.json",
  "title": "Survey Theme Override Schema",
  "description": "Defines which survey tokens can be overridden by clients via SurveyThemeOverrides. Protected tokens are internal-use only.",
  "type": "object",
  "properties": {
    "brand": {
      "description": "Brand customization tokens",
      "type": "object",
      "properties": {
        "primary": {
          "$ref": "#/definitions/hsl",
          "description": "Primary brand color — overridable"
        },
        "primaryForeground": {
          "$ref": "#/definitions/hsl",
          "description": "Primary foreground color — overridable"
        }
      }
    },
    "surfaces": {
      "description": "Surface color tokens",
      "type": "object",
      "properties": {
        "background": {
          "$ref": "#/definitions/hsl",
          "description": "Page background — overridable"
        },
        "foreground": {
          "$ref": "#/definitions/hsl",
          "description": "Primary text color — overridable"
        },
        "card": {
          "$ref": "#/definitions/hsl",
          "description": "Card background — overridable"
        },
        "cardForeground": {
          "$ref": "#/definitions/hsl",
          "description": "Card text color — overridable"
        },
        "muted": {
          "$ref": "#/definitions/hsl",
          "description": "Muted/subtle background — overridable"
        },
        "mutedForeground": {
          "$ref": "#/definitions/hsl",
          "description": "Muted text color — overridable"
        },
        "accent": {
          "$ref": "#/definitions/hsl",
          "description": "Accent/hover background — overridable"
        },
        "accentForeground": {
          "$ref": "#/definitions/hsl",
          "description": "Accent text color — overridable"
        }
      }
    },
    "interactive": {
      "description": "Interactive element tokens",
      "type": "object",
      "properties": {
        "border": {
          "$ref": "#/definitions/hsl",
          "description": "Default border color — overridable"
        },
        "borderUi": {
          "$ref": "#/definitions/hslAlpha",
          "description": "UI element borders (inputs, selects) — overridable"
        },
        "input": {
          "$ref": "#/definitions/hsl",
          "description": "Input background — overridable"
        },
        "ring": {
          "$ref": "#/definitions/hsl",
          "description": "Focus ring color — overridable"
        }
      }
    },
    "geometry": {
      "description": "Border radius tokens",
      "type": "object",
      "properties": {
        "radius": {
          "$ref": "#/definitions/length",
          "description": "Default border radius — overridable"
        },
        "radiusSm": {
          "$ref": "#/definitions/length",
          "description": "Small border radius — overridable"
        },
        "radiusMd": {
          "$ref": "#/definitions/length",
          "description": "Medium border radius — overridable"
        },
        "radiusLg": {
          "$ref": "#/definitions/length",
          "description": "Large border radius — overridable"
        },
        "radiusXl": {
          "$ref": "#/definitions/length",
          "description": "Extra large border radius — overridable"
        }
      }
    },
    "typography": {
      "description": "Typography tokens",
      "type": "object",
      "properties": {
        "fontFamily": {
          "type": "string",
          "description": "Font family — overridable"
        }
      }
    }
  },
  "definitions": {
    "hsl": {
      "type": "string",
      "pattern": "^[0-9]{1,3}\\s+[0-9]{1,3}%\\s+[0-9]{1,3}%$",
      "examples": ["0 0% 23%", "220 10% 95%"],
      "description": "HSL color: hue saturation% lightness%"
    },
    "hslAlpha": {
      "type": "string",
      "pattern": "^[0-9]{1,3}\\s+[0-9]{1,3}%\\s+[0-9]{1,3}%\\s+/\\s*[0-9.]+$",
      "examples": ["0 0% 23% / 0.25"],
      "description": "HSL with alpha: hue saturation% lightness% / alpha"
    },
    "length": {
      "type": "string",
      "pattern": "^[0-9.]+(rem|em|px)$",
      "examples": ["0.375rem", "6px", "0.5em"],
      "description": "CSS length value"
    }
  },
  "_protected": {
    "description": "Protected tokens — NOT overridable by clients",
    "tokens": [
      "--survey-destructive",
      "--survey-destructive-foreground",
      "--survey-destructive-border",
      "--survey-success",
      "--survey-success-foreground",
      "--survey-warning",
      "--survey-warning-foreground",
      "--survey-warning-border",
      "--survey-info",
      "--survey-info-foreground",
      "--survey-info-border",
      "--survey-font-size-xs",
      "--survey-font-size-sm",
      "--survey-font-size-base",
      "--survey-font-size-lg",
      "--survey-font-size-xl",
      "--survey-font-size-2xl",
      "--survey-focus-ring"
    ],
    "rationale": "Semantic status colors and protected typography ensure WCAG compliance and consistent accessibility across all survey clients."
  },
  "_migration": {
    "oklch": {
      "description": "Future migration path to OKLCH for perceptual uniformity",
      "tokens": [
        "--survey-primary",
        "--survey-background",
        "--survey-foreground",
        "--survey-muted"
      ],
      "timeline": "Post-M3 stable release"
    }
  }
}
